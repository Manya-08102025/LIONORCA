# Lionorca Architeriors - Environment Configuration
# Copy this file to .env or .env.local to link your Supabase or Firebase project

# ── Supabase Configuration ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Firebase Configuration (Optional) ───────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=lionorca-architeriors.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lionorca-architeriors
VITE_FIREBASE_STORAGE_BUCKET=lionorca-architeriors.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
